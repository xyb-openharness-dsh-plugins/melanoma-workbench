{
  "name": "@xyb-community/melanoma-workbench",
  "version": "0.2.0",
  "description": "面向皮肤黑色素瘤患者与照护者的本机病程资料、皮损自查与照片对比、分期与前哨淋巴结、BRAF/NRAS 分子、免疫治疗副作用与双轨随访工作台设计项目",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/check-workbench-package.mjs .",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run audit",
    "pack:check": "npm pack --dry-run",
    "demo:data": "node demo/build-demo-data.mjs",
    "probe:proto": "node scripts/probe-proto.mjs",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "probe": "npm run probe:proto && npm run probe:resp"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/melanoma-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
